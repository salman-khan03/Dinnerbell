# Copy to .env and fill in what you need. All of these are optional for local
# development — `npm run dev` works with nothing set (anonymous demo mode).
# Load them however you like (a `dotenv` step, your shell, your host's env
# panel) — main.ts reads plain process.env and does not load .env itself.

# ── networking ──
PORT=8787
HOST=0.0.0.0
# The canonical https origin once deployed. Required for a real Alexa+ install
# (it becomes the OAuth issuer and the MCP resource identifier).
# PUBLIC_URL=https://dinnerbell.example.com

# ── storage ──
# Postgres (use this on any host with an ephemeral disk). Apply db/schema.sql once.
# Takes priority over DATA_DIR when set.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Where store.json (households, plans, tokens) lives when there's no DATABASE_URL. Empty = in-memory only.
DATA_DIR=./data

# ── local development shortcuts (default ON when NODE_ENV != production) ──
# ALLOW_ANONYMOUS=1   # skip OAuth, everyone shares one demo household
# DEMO_LOGIN=1        # show "Try a demo kitchen" on the sign-in page
# DEMO_CLOCK=1        # honour the x-dinner-bell-now header (the simulator's clock control)

# ── Alexa+ account linking (production) ──
# ALEXA_CLIENT_ID=amzn1.application-oa2-client....
# ALEXA_CLIENT_SECRET=...
# ALEXA_REDIRECT_URIS=https://pitangui.amazon.com/api/skill/link/M2XXXXXXXXXXXX

# ── AWS Builder mini-challenge: Amazon Bedrock picks the simulator's tool calls ──
# Needs AWS credentials on the environment (env vars, shared config, or an
# instance/task role) with bedrock:InvokeModel for the chosen model.
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS_REGION=us-east-1

# ── hardening (production) ──
# Behind a host's reverse proxy (Render, Railway, Fly…), rate-limit sign-ins by the real client IP.
# Only set this when a proxy you trust always sets X-Forwarded-For, or clients can spoof it.
# TRUST_PROXY=1
# ALLOWED_HOSTS=dinnerbell.example.com
# CORS_ORIGINS=https://inspector.example.com
